digraph plan {
    graph [
        inputs="goal",
        outputs="plan-status.json,task-packet.md,testing-plan.md,validation-plan.md",
        model_stylesheet="
            * { agent_class: quick_easy; }
        "
    ]

    start   [shape=Mdiamond, label="Start"]
    planner [shape=box, label="Plan Intake", agent_class="quick_easy",
             prompt="You are Kilroy's fast intake and planning station. Read .kilroy/INPUT.md. Your job is to either ask for the most important missing clarification or produce a manufacturable task packet.\n\nFirst-pass clarification gate: if there is no ## clarifications section, and the ## goal section does not explicitly say something like 'do not ask questions', 'use your judgment', 'proceed without clarification', or 'dealer's choice', you MUST write status NEEDS_CLARIFICATION. This is true even when the bug or likely fix appears obvious. Ask at most 3 high-leverage questions, and each question must include a recommended default answer that would let the user proceed quickly. Do not write READY_TO_IMPLEMENT on a first pass unless the user already supplied clarifications or explicitly waived questions.\n\nNever reject a request because it is large. For very large work, use NEEDS_DECOMPOSITION and describe the first decomposition wave, budget/risk assumptions, and what must be planned before implementation.\n\nRisk rule: if the next step could spend meaningful money, deploy to prod/staging, delete data, rewrite history, or otherwise cause harm, use ESCALATE_RISK unless the input explicitly authorizes that class of action.\n\nAlways write these files at the workspace root:\n1. plan-status.json with schema: {\"status\":\"NEEDS_CLARIFICATION|READY_TO_IMPLEMENT|NEEDS_DECOMPOSITION|ESCALATE_RISK\",\"classification\":\"bug|feature|investigation|greenfield|validation|maintenance|unknown\",\"questions\":[{\"question\":\"...\",\"recommended_default\":\"...\",\"why_it_matters\":\"...\"}],\"assumptions\":[\"...\"],\"risk_flags\":[\"...\"],\"session_notes\":\"...\"}\n2. task-packet.md using sections: Intent, Source, Scope, Non-goals, Starting evidence, Implementation direction, No-op/escalation rules, Budget/risk.\n3. testing-plan.md with unit/integration/build checks the implement loop should use.\n4. validation-plan.md with external behavior/evidence requirements for the validate workflow.\n\nIf status is NEEDS_CLARIFICATION, task-packet/testing/validation may be partial but should preserve useful assumptions and recommended defaults. If status is READY_TO_IMPLEMENT, make them concrete enough that a coding loop can proceed without reading your mind. Keep output concise and practical.\n\nWhen finished, write {\"status\":\"success\"} to $KILROY_STAGE_STATUS_PATH or $KILROY_STAGE_STATUS_FALLBACK_PATH if that fails."]
    ensure_outputs [shape=parallelogram, label="ensure outputs",
                    tool_command="bash .kilroy/package/scripts/ensure-outputs.sh"]
    done    [shape=Msquare, label="Done"]
    failed  [shape=Msquare, terminal_status="fail", label="Failed",
             failure_reason="plan_failed"]

    start          -> planner
    planner        -> ensure_outputs [condition="outcome=success"]
    planner        -> failed         [condition="outcome!=success"]
    ensure_outputs -> done           [condition="outcome=success"]
    ensure_outputs -> failed         [condition="outcome!=success"]
}
