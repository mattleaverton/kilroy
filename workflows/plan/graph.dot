// plan: intake/classify via single API call, then fan out to three parallel
// planning agents when the goal is ready to implement.

digraph plan {
    graph [
        inputs="goal",
        outputs="plan-status.json,task-packet.md,testing-plan.md,validation-plan.md"
    ]

    start [shape=Mdiamond, label="Start"]

    // Single API call: classify the goal and output plan-status.json JSON.
    // agent_class="quickapi" resolves to a fast SDK/API model with a
    // cross-provider fallback chain; agent_mode="one_shot" keeps it a single
    // HTTP call. auto_status skips the status.json requirement since one_shot
    // can't write files. Input materialization preamble injects
    // goal/clarifications/preferences content.
    classifier [
        shape=box,
        label="Classify",
        agent_mode="one_shot",
        auto_status="true",
        agent_class="quickapi",
        prompt="Classify this goal and output a single JSON object — nothing else.\n\nThe inputs section above contains the goal and any clarifications or preferences the user provided.\n\nKilroy's contract with the user: drop a note, walk away, come back to validated code. The DEFAULT status is READY_TO_IMPLEMENT — assume Kilroy is being asked to ship a change. Returning NEEDS_CLARIFICATION makes the user come back for another turn, so reserve it for goals that are genuinely unactionable even with reasonable assumptions; prefer assuming and proceeding.\n\nClassification rules:\n- READY_TO_IMPLEMENT (DEFAULT): The goal is actionable enough to plan and code, even if it requires reasonable assumptions. Diagnostic-shaped goals ('find what's wrong with X', 'see why Y is broken', 'investigate Z') are implementation work — Kilroy fixes things; it does not write reports. List your working assumptions in the 'assumptions' field so the planners can use them.\n- NEEDS_CLARIFICATION: Reserved for goals so vague no reasonable assumption produces an actionable packet ('make it better', 'do the thing', 'help me with the app'). Bias hard toward not asking — every question is a turn the user has to come back for. If you must ask, at most 3 high-leverage questions, each with a recommended_default that lets the user proceed without answering.\n- NEEDS_DECOMPOSITION: The work is genuinely too large for a single implement run. Describe the first wave.\n- ESCALATE_RISK: The next step could spend meaningful money, deploy to prod, delete data, or cause irreversible harm without explicit authorization.\n\nThe 'investigation' value in the classification field is metadata only, and it is rare. Use it ONLY when the user EXPLICITLY opts out of code changes ('don't touch the code', 'read-only audit', 'just tell me what's broken', 'no changes'). A diagnostic-phrased goal is not an opt-out — classify it as 'bug' or similar and status stays READY_TO_IMPLEMENT.\n\nYour entire response must be a single JSON object. Start with { and end with }. No preamble, no explanation, no code fences.\n\nSchema:\n{\n  \"status\": \"NEEDS_CLARIFICATION\" | \"READY_TO_IMPLEMENT\" | \"NEEDS_DECOMPOSITION\" | \"ESCALATE_RISK\",\n  \"classification\": \"bug\" | \"feature\" | \"investigation\" | \"greenfield\" | \"validation\" | \"maintenance\" | \"unknown\",\n  \"questions\": [{\"question\": \"...\", \"recommended_default\": \"...\", \"why_it_matters\": \"...\"}],\n  \"assumptions\": [\"...\"],\n  \"risk_flags\": [\"...\"],\n  \"session_notes\": \"...\"\n}\n\nquestions must be an array even when empty. All fields are required."
    ]

    // Parse the classifier's raw response into plan-status.json. Prints "ready"
    // or "clarify" to stdout (surfaced as context.tool.output for routing); a
    // genuine error (missing/unparseable response) exits non-zero -> outcome=fail.
    gate [
        shape=parallelogram,
        label="Gate",
        tool_command="bash .kilroy/package/scripts/gate.sh"
    ]

    // Concurrent fan-out: three parallel planning agents in the same workspace.
    fan_out [shape=pentagon, concurrent_id="planning", label="Plan Fan-out"]

    task_planner [
        shape=box,
        label="Task Planner",
        agent_class="architectural_critique",
        prompt="Write task-packet.md for the coding implement workflow.\n\nRead .kilroy/INPUT.md and plan-status.json. The ## goal section (and ## clarifications / ## preferences if present) describe what to build.\n\nWrite task-packet.md with these sections:\n## Intent\nWhat should become true when this task is complete? (2-4 sentences)\n\n## Source\nWhere did this come from? User request / bug / ticket / prior run.\n\n## Scope\nExact repos, packages, files, or features in scope.\n\n## Non-goals\nWhat to leave alone. Be specific.\n\n## Starting Evidence\nHow to reproduce the bug or observe current behavior. Concrete commands, logs, URLs if known. If nothing is known, say so.\n\n## Implementation Direction\nThe approach to take. Specific enough that a coding agent can start without guessing.\n\n## No-op / Escalation Rules\nWhen no code change is the right answer. When a human must approve.\n\n## Budget / Risk\nAllowed network, external API calls, destructive actions, staging/prod deploys.\n\nKeep each section concrete and actionable. Do not pad with generic advice.\n\nWhen finished, write {\"status\":\"success\"} to $KILROY_STAGE_STATUS_PATH or $KILROY_STAGE_STATUS_FALLBACK_PATH if that fails."
    ]

    test_planner [
        shape=box,
        label="Test Planner",
        agent_class="quick_easy",
        prompt="Write testing-plan.md for the coding implement workflow.\n\nRead .kilroy/INPUT.md and plan-status.json. The ## goal section describes what is being built.\n\nBefore writing, if there is a package.json in the workspace, read it and list only the scripts that actually exist. Never invent npm script names.\n\nWrite testing-plan.md with these sections:\n## Unit / Integration Tests\nSpecific test files or test commands to run. Name the actual test runner (pytest, go test, jest, etc.). If the repo has no test framework, say so.\n\n## Build Check\nThe exact command to verify the project builds (go build ./..., npm run check, cargo build, etc.). Prefer existing CI-level check scripts over raw compilers.\n\n## Lint / Type Check\nIf the project has a lint or type-check command, name it. If not, say so.\n\n## Coverage Obligation\nWhat the implement loop MUST verify passes before the critic can say COMPLETE. Be specific: 'go test ./... must pass' beats 'tests should pass'.\n\n## Known Gaps\nThings we cannot test automatically and why.\n\nDo not invent scripts. Ground every command in what the project actually has.\n\nWhen finished, write {\"status\":\"success\"} to $KILROY_STAGE_STATUS_PATH or $KILROY_STAGE_STATUS_FALLBACK_PATH if that fails."
    ]

    validation_planner [
        shape=box,
        label="Validation Planner",
        agent_class="quick_easy",
        prompt="Write validation-plan.md for the external validate workflow.\n\nRead .kilroy/INPUT.md and plan-status.json. The ## goal section describes what is being built.\n\nThe validate workflow runs AFTER implementation in a real environment. It proves the delivered behavior works from the outside, the way a real user or operator would interact with it.\n\nCRITICAL CONSTRAINTS — read before writing:\n- This plan is written BEFORE the implementation exists. You do not know the exact output strings, exit messages, or internal code paths. Focus on observable user-facing behavior, not internal failure modes or output-format details.\n- Validation is NOT unit testing. Do NOT include scenarios that work by artificially manipulating the environment (e.g. 'PATH=/usr/bin:/bin command', 'clear all credentials', 'corrupt the config file') to trigger internal error paths. Those belong in testing-plan.md.\n- Every scenario must be something a real user would actually do toward the stated goal — happy paths, normal operation, obvious uses. At most one or two scenarios may cover a user-realistic mistake (typo'd argument, missing required input); do not enumerate internal failure modes.\n- Do not prescribe the implementer's output strings. Pass criteria should be things checkable from exit code, file existence/content, HTTP response, or whether the output meaningfully communicates the result — not 'the output contains the word X' grep matches.\n- Do not assert anything an agent cannot verify from artifacts ('output is clear to non-technical users', 'response time is acceptable', 'works in CI/CD'). Put unfalsifiable things in Residual Risk.\n\nWrite validation-plan.md with these sections:\n\n## What Success Looks Like\n2-4 sentences: what observable user-facing behavior, in normal use, proves the goal is met?\n\n## Validation Scenarios\n3-6 numbered scenarios. Each is a thing a real user would do. Each must specify:\n- Setup: minimal preconditions (assume the feature is built and the environment is normal)\n- Action: the exact command, request, or interaction\n- Pass criterion: a concrete check the validator agent can make — exit code, presence/content of a named file, HTTP status/body, or whether the output communicates the result. NOT exact-word matching against guessed output.\n\n## Environment Requirements\nWhat must be running, installed, or available for the scenarios (binary on PATH, network, credentials, running service). Real requirements only.\n\n## Residual Risk\nWhat this plan cannot prove and why — things needing a human, a real deployment, or time-series observation. Be specific.\n\nThe validator agent has shell, curl, and browser tools. Write so it can execute each scenario step by step, but do not prescribe implementer choices.\n\nWhen finished, write {\"status\":\"success\"} to $KILROY_STAGE_STATUS_PATH or $KILROY_STAGE_STATUS_FALLBACK_PATH if that fails."
    ]

    fan_in [shape=cylinder, concurrent_id="planning", label="Plan Fan-in"]

    ensure_outputs [
        shape=parallelogram,
        label="Ensure Outputs",
        tool_command="bash .kilroy/package/scripts/ensure-outputs.sh"
    ]

    // Reached when the gate routes "clarify" (NEEDS_CLARIFICATION / NEEDS_DECOMPOSITION / ESCALATE_RISK).
    // Not a fail terminal — the run succeeded; it returned a structured non-ready status.
    clarified [shape=Msquare, label="Clarification Needed"]

    done   [shape=Msquare, label="Done"]
    failed [shape=Msquare, terminal_status="fail", label="Failed",
            failure_reason="plan_failed"]

    start      -> classifier
    classifier -> gate       [condition="outcome=success"]
    classifier -> failed     [condition="outcome!=success"]

    gate -> clarified [condition="context.tool.output=clarify"]
    gate -> failed    [condition="outcome=fail"]
    // Unconditional fallback: proceed to planning. The gate prints "ready" to
    // route here; "clarify" and genuine errors are caught by the edges above.
    gate -> fan_out

    fan_out -> task_planner
    fan_out -> test_planner
    fan_out -> validation_planner

    task_planner       -> fan_in
    test_planner       -> fan_in
    validation_planner -> fan_in

    fan_in -> ensure_outputs [condition="outcome=success"]
    fan_in -> failed         [condition="outcome!=success"]

    ensure_outputs -> done   [condition="outcome=success"]
    ensure_outputs -> failed [condition="outcome!=success"]
}
