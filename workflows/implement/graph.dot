// implement: public planner/coder/critic/status loop.

digraph implement {
    graph [
        inputs="task_packet",
        outputs="result.md,implementation.patch,STATUS.md",
        model_stylesheet=""
    ]

    start  [shape=Mdiamond, label="Start"]
    done   [shape=Msquare,  label="Done"]
    failed [shape=Msquare,  terminal_status="fail", label="Failed",
            failure_reason="implement_loop_did_not_complete"]

    stage_context [
        shape=parallelogram,
        label="stage-context",
        tool_command="bash .kilroy/package/scripts/stage-context.sh"
    ]

    loop_begin [
        shape=trapezium,
        label="Loop Begin",
        loop_id="main",
        loop_max=20,
        loop_until_file_contains=".kilroy/decision.md:COMPLETE"
    ]

    loop_end [
        shape=invtrapezium,
        label="Loop End",
        loop_id="main",
        loop_max=20,
        loop_until_file_contains=".kilroy/decision.md:COMPLETE"
    ]

    planner [
        shape=box,
        label="Planner",
        agent_mode="agent_loop",
        llm_provider="anthropic",
        llm_model="claude-sonnet-4.6",
        prompt="You are the planner in Kilroy's public implement workflow. Pick ONE narrow next sub-task.\n\nSteps:\n1. Read .kilroy/INPUT.md. The ## task_packet section is authoritative. The optional ## testing_plan and ## validation_plan sections are requirements.\n2. If ## context_files_contents exists, skim it.\n3. If ## project_scripts exists, use only scripts listed there. Do not invent npm scripts.\n4. If .kilroy/feedback/latest.md exists, read it for critic feedback from the prior iteration.\n5. Run: git log --oneline -10\n6. Run: git status -sb\n7. Pick EXACTLY ONE smallest-possible self-contained sub-task. Do not bundle features.\n   - No code yet -> pick a red test or smallest foundation step only.\n   - Foundation exists -> pick the single smallest remaining behavior.\n   - Validation failed -> pick just the failure repair.\n8. Write .kilroy/plan.md under 40 lines with sections:\n   ## What to implement\n   ## Acceptance criteria\n   ## Test obligation\n   ## Validation obligation\n   ## Files likely affected\n   ## Guardrail\nThe guardrail section must say: Do NOT implement any other features in this iteration. Stop immediately after the scoped sub-task is complete. Never use git commit --no-verify.\n\nWhen finished, write {\"status\":\"success\"} to $KILROY_STAGE_STATUS_PATH or $KILROY_STAGE_STATUS_FALLBACK_PATH if that fails."
    ]

    coder [
        shape=box,
        label="Coder",
        agent_tool="opencode",
        llm_provider="kimi",
        llm_model="kimi-k2.5",
        prompt="You are the coder in Kilroy's public implement workflow. Implement EXACTLY what .kilroy/plan.md asks for, nothing more.\n\nSteps:\n1. Read .kilroy/plan.md.\n2. Read .kilroy/INPUT.md, especially ## task_packet, ## testing_plan, ## validation_plan, and ## project_scripts if present.\n3. Implement only the scoped sub-task. Use existing project patterns. Do not refactor unrelated code.\n4. Run the targeted test/build named in .kilroy/plan.md if practical. If it names an npm script not present in ## project_scripts, do not run it; use an existing listed script or report the mismatch.\n5. Before committing, remove generated caches/build artifacts such as __pycache__, .pytest_cache, node_modules, dist, coverage, binaries, and temporary logs unless the task explicitly asks for them. Add a minimal ignore rule if the project lacks one and the command generated common cache artifacts.\n6. Stage and commit only substantive source/test/doc/config changes with a clear message. Never use git commit --no-verify. If hooks fail, fix the environment or report the blocker; do not bypass hooks.\n\nIf the task is genuinely already done, write .kilroy/no-op.md with evidence and commit that. Do not claim completion without either a substantive code/test commit or a no-op evidence file.\n\nWhen finished, write {\"status\":\"success\"} to $KILROY_STAGE_STATUS_PATH or $KILROY_STAGE_STATUS_FALLBACK_PATH if that fails."
    ]

    verify_build [
        shape=parallelogram,
        label="verify-build",
        tool_command="bash .kilroy/package/scripts/verify-build.sh"
    ]

    critic [
        shape=box,
        label="Critic",
        agent_tool="codex",
        llm_provider="openai",
        llm_model="gpt-5.4-mini",
        prompt="You are the critic in Kilroy's public implement workflow. Be strict: it should be hard to exit the loop, but judge the substantive run diff, not engine bookkeeping commits.\n\nSteps:\n1. Read .kilroy/plan.md.\n2. Read .kilroy/INPUT.md and judge against ## task_packet, ## testing_plan, and ## validation_plan.\n3. Read BASE from .kilroy/base-sha.txt if it exists. Otherwise infer the last non-attractor commit before this run from git log.\n4. Run: git log --oneline -10\n5. Run: git diff --stat \"$BASE\"..HEAD -- . ':(exclude).kilroy/**' ':(exclude)STATUS.md' 2>/dev/null || git diff --stat HEAD~5..HEAD\n6. Read .kilroy/build-output.txt.\n7. Check for generated junk in the substantive diff: git diff --name-only \"$BASE\"..HEAD -- . ':(exclude).kilroy/**' ':(exclude)STATUS.md' 2>/dev/null || true\n8. Compute iteration number:\n   mkdir -p .kilroy/feedback\n   N=$(find .kilroy/feedback -maxdepth 1 -name 'iter-*.md' 2>/dev/null | wc -l | tr -d ' ')\n   ITER=$((N + 1))\n   PADDED=$(printf '%03d' $ITER)\n9. Write .kilroy/feedback/iter-${PADDED}.md and overwrite .kilroy/feedback/latest.md with sections:\n   ## Iteration ${PADDED}\n   ## What changed\n   ## Build outcome\n   ## Against task packet\n   ## Against testing plan\n   ## Against validation plan\n   ## Quality notes\n   ## Recommendation\nRecommendation must be CONTINUE if required task items remain, build or required tests fail, validation evidence is missing, implementation has a bug, generated cache/build artifacts are tracked, or the substantive diff since BASE is empty without .kilroy/no-op.md. Recommendation may be COMPLETE only when all required items are correctly implemented, required tests/build passed or are explicitly impossible with evidence, validation obligations are satisfied enough for validate to run, and there is a non-empty substantive diff since BASE unless this is a documented NO_OP.\n10. Stage and commit feedback with: git add -f .kilroy/feedback/ && git commit -m \"critic: iteration ${PADDED} feedback\"\n11. Write exactly COMPLETE or CONTINUE to .kilroy/decision.md.\n\nWhen finished, write {\"status\":\"success\"} to $KILROY_STAGE_STATUS_PATH or $KILROY_STAGE_STATUS_FALLBACK_PATH if that fails."
    ]

    status_pulse [
        shape=box,
        label="Status Pulse",
        agent_class="quick_easy",
        prompt="Write STATUS.md for external monitors of this implement run.\n\nRead .kilroy/INPUT.md, .kilroy/plan.md, .kilroy/feedback/latest.md, .kilroy/decision.md if present, git log --oneline -10, and .kilroy/build-output.txt. Overwrite STATUS.md with sections:\n# Implement Status\n_last updated: <ISO 8601 timestamp>_\n\n## Goal\n(1-3 sentences from task_packet)\n\n## Progress\n- Iterations completed: N / 20\n- Most recent task: ...\n- Latest decision: COMPLETE | CONTINUE | none\n- Build: PASS | FAIL | not attempted\n\n## Trajectory\n(3-6 bullets from feedback)\n\n## Stuck signal\nSTUCK or PROGRESSING with one concrete reason.\n\nKeep STATUS.md under 60 lines. When finished, write {\"status\":\"success\"} to $KILROY_STAGE_STATUS_PATH or $KILROY_STAGE_STATUS_FALLBACK_PATH if that fails."
    ]

    final_report [
        shape=parallelogram,
        label="final-report",
        tool_command="bash .kilroy/package/scripts/final-report.sh",
        max_retries="0"
    ]

    start         -> stage_context
    stage_context -> loop_begin     [condition="outcome=success"]
    stage_context -> final_report   [condition="outcome!=success"]

    loop_begin    -> planner
    planner       -> coder          [condition="outcome=success"]
    planner       -> final_report   [condition="outcome!=success"]
    coder         -> verify_build   [condition="outcome=success"]
    coder         -> final_report   [condition="outcome!=success"]
    verify_build  -> critic
    critic        -> status_pulse   [condition="outcome=success"]
    critic        -> final_report   [condition="outcome!=success"]
    status_pulse  -> loop_end
    loop_end      -> final_report

    final_report  -> done           [condition="outcome=success"]
    final_report  -> failed         [condition="outcome!=success"]
}
